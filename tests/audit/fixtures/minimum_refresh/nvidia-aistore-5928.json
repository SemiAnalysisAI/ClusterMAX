            "cve": "CVE-2026-100986",
            "cwe": {
                "id": "CWE-73",
                "name": "External Control of File Name or Path"
            },
            "notes": [
                {
                    "category": "summary",
                    "text": "NVIDIA AIStore contains a vulnerability in append-operation handle validation where an unauthenticated attacker could cause data to be appended to a file outside the intended storage location. A successful exploit might lead to code execution, denial of service, escalation of privileges, information disclosure, or data tampering.",
                    "title": "Vulnerability description"
                },
                {
                    "category": "details",
                    "text": "code execution, escalation of privileges, data tampering, denial of service, information disclosure",
                    "title": "Impacts"
                },
                {
                    "category": "details",
                    "text": "6719612",
                    "title": "defect"
                }
            ],
            "product_status": {
